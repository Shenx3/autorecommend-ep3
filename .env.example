# Copia este archivo como .env y cambia los valores
API_KEY=cambia-esta-clave
RABBIT_USER=autorec
RABBIT_PASS=cambia-esta-clave-tambien
AWS_REGION=us-east-1
SAGEMAKER_ENDPOINT=autorecommend-endpoint
# Limite de peticiones por IP. Para la prueba de carga subelo (ej: 100000/minute)
RATE_LIMIT=100/minute
# Segundos de espera al endpoint de SageMaker antes de usar el fallback Top Sellers
SAGEMAKER_TIMEOUT=2
